# Database (MongoDB connection URI)
MONGO_URI=mongodb://localhost:27017/stemsage

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# CORS Allowed Origins (supports comma-separated origins)
FRONTEND_URL=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudinary (Media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mailer / SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
CONTACT_EMAILS=info@stemsage.com

# Initial Admin User Creation (scripts/createAdmin.js)
ADMIN_EMAIL=admin@stemsage.com
ADMIN_PASSWORD=your_admin_password_here
